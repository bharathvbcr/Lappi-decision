# The pinned TEACHER environment (S1, second image). Built with podman, not docker.
#
#   podman build --platform linux/amd64 -t qd-teacher:s1 -f stack/Containerfile.teacher .
#
# Context is the REPO ROOT, for the same reason the trainer's is: the gate imports
# `qd_train.tristate`, which a stack/-only context cannot reach. See `.containerignore`.
#
# Why this exists as a second image at all is section 3 of stack/README.md: one lockfile
# holding both vLLM and the trainer resolved to torch 2.11.0+cu128 on paper while pulling
# BOTH CUDA wheel families and installing torch 2.14.0+cu130, after which causal-conv1d
# refused to compile against a 12.8 base. The split is forced by that evidence.
#
# Base is **-runtime**, not -devel, and that is the whole difference from the trainer.
# `teacher.lock` is prebuilt wheels end to end -- nothing here compiles, so the ~6 GB of
# toolchain in a -devel base would be dead weight in an image that already carries vLLM.
# Note `nvidia-cuda-nvcc==13.4.92` IS in the lock: flashinfer JITs kernels at run time and
# gets its nvcc from that wheel, not from the base image. A -devel base would supply a
# SECOND nvcc at a different version, which is the kind of quiet duplication that decides a
# run's behaviour six hours in.
#
# CUDA **13**, against the trainer's 12.8, because that is what vLLM's own constraint
# resolved to: nvidia-cuda-runtime==13.0.96, nvidia-nccl-cu13, nvidia-cudnn-cu13.
#
# Verified 2026-09-19 with `podman manifest inspect`: this tag exists and publishes 2
# platform entries (arm64, amd64). The floating `13.0-runtime-ubuntu24.04` tag does **not**
# exist -- `manifest unknown` -- so the three-component version is required here rather than
# stylistic.
FROM docker.io/nvidia/cuda:13.0.1-runtime-ubuntu24.04

# Fail on any pipeline error, not just the last command's.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# UV_NO_CACHE, not PIP_NO_CACHE_DIR -- uv does not read the latter. See the same note in
# stack/Containerfile; getting this wrong cost the trainer build an ENOSPC failure.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1

# No build-essential and no ninja: nothing in teacher.lock builds from source. If a future
# resolution adds an sdist, this build fails loudly at that package rather than silently
# growing a toolchain -- which is the behaviour we want, because an sdist appearing in the
# teacher lock is a resolution change worth noticing, not worth accommodating.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv

# A venv rather than --system: Ubuntu 24.04 marks its Python externally-managed (PEP 668),
# and `uv pip install --system` fails outright with EXTERNALLY-MANAGED.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN uv venv --python 3.12 /opt/venv

WORKDIR /opt/qd

# 196 pins, resolved against x86_64-manylinux_2_28 / py3.12 and committed. torch is
# deliberately UNPINNED in teacher.in -- vLLM's own constraint decides it, and pinning it to
# a value vLLM disagrees with is precisely what broke the combined lockfile. The resolved
# version lands in teacher.lock and in the ledger's env block.
COPY stack/teacher.lock /opt/qd/teacher.lock
RUN uv pip install --python /opt/venv/bin/python -r /opt/qd/teacher.lock

# Layout mirrors the repo — `stack/` beside `python/` — so that the gate's
# `Path(__file__).resolve().parents[1] / "python"` is right here and in a checkout, with no
# container-only branch. The trainer image got this wrong first and tagged clean with a gate
# that could not import.
COPY python/qd_train /opt/qd/python/qd_train
COPY python/qd_data /opt/qd/python/qd_data
COPY stack/verify_teacher.py /opt/qd/stack/verify_teacher.py

# Same discipline as the trainer's gate: this asserts a positive fact and exits non-zero on
# `not_run` as well as on failure, because an unchecked environment is not a clean one.
#
# NOT run at build time -- it needs a GPU and the build host has none. It runs as the first
# step of Session 0, before any labelling work is dispatched.
CMD ["python", "/opt/qd/stack/verify_teacher.py", "--json"]
