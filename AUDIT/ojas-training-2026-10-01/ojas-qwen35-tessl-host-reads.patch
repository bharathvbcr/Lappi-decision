+fn entry<'s, 'a>(what: &str, slots: &'s [Slot<'a>], i: usize) -> Result<&'s Slot<'a>, String> {
+    slots
+        .get(i)
+        .ok_or_else(|| format!("{what}: entry {i} of a {}-entry table", slots.len()))
+}
