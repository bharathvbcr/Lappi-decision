+/// A per-entry host read: entry index, then the caller's buffer.
+type HostRead<'a> = &'a dyn Fn(usize, &mut [f32]) -> Result<(), String>;
+
+/// One entry at a time on the host is the whole-table device copies' bits,
+/// for values, gradients and both AdamW moments; a host write round-trips
+/// and moves the step; a bad index or length is refused before anything is
+/// mapped or written.
+#[test]
+fn host_entries_are_the_table_copies_bit_for_bit() {
+    let (rt, model, _st) = load(Precision::F32);
+    let ids = ids();
+    let table = model.parameter_table().unwrap();
+    let step = model.train_step(&ids, GemmOperands::ExactF32).unwrap();
+    let mut state = AdamW::new(&model).unwrap();
+    let wd = model.default_weight_decay(0.01).unwrap();
+    model
+        .adamw_step(&step.grads, &mut state, &AdamWHyper::default(), &wd)
+        .unwrap();
+    let bits = |v: &[f32]| v.iter().map(|x| x.to_bits()).collect::<Vec<u32>>();
+    let same = |what: &str, dst: &[Tensor], host: HostRead<'_>| {
+        for (i, (p, t)) in table.iter().zip(dst).enumerate() {
+            let mut out = vec![f32::NAN; t.numel()];
+            host(i, &mut out).unwrap();
+            assert_eq!(bits(&out), bits(&t.read_f32().unwrap()), "{what} {}", p.name);
+        }
+    };
+    let params = alloc(&rt, &table);
+    model.read_parameters(&params).unwrap();
+    same("value", &params, &|i, out| model.read_parameter_host(i, out));
+    let grads = alloc(&rt, &table);
+    model.read_gradients(&step.grads, &grads).unwrap();
+    same("gradient", &grads, &|i, out| {
+        model.read_gradient_host(&step.grads, i, out)
+    });
+    for which in [Moment::First, Moment::Second] {
+        let m = alloc(&rt, &table);
+        model.read_adamw_moment(&state, which, &m).unwrap();
+        same("moment", &m, &|i, out| {
+            model.read_adamw_moment_host(&state, which, i, out)
+        });
+    }
+
+    // A host write of every entry, then the device copy reads it back.
+    let before = model.train_step(&ids, GemmOperands::ExactF32).unwrap().loss;
+    let scaled: Vec<Vec<f32>> = params
+        .iter()
+        .map(|t| t.read_f32().unwrap().iter().map(|x| x * 0.5).collect())
+        .collect();
+    for (i, v) in scaled.iter().enumerate() {
+        model.write_parameter_host(i, v).unwrap();
+    }
+    let back = alloc(&rt, &table);
+    model.read_parameters(&back).unwrap();
+    for ((p, t), v) in table.iter().zip(&back).zip(&scaled) {
+        assert_eq!(bits(&t.read_f32().unwrap()), bits(v), "write {}", p.name);
+    }
+    let after = model.train_step(&ids, GemmOperands::ExactF32).unwrap().loss;
+    assert_ne!(after.to_bits(), before.to_bits(), "a host write did not move the step");
+    let m0: Vec<f32> = vec![0.125; table[0].shape.iter().product()];
+    model
+        .write_adamw_moment_host(&mut state, Moment::Second, 0, &m0)
+        .unwrap();
+    let mut out = vec![0.0; m0.len()];
+    model
+        .read_adamw_moment_host(&state, Moment::Second, 0, &mut out)
+        .unwrap();
+    assert_eq!(bits(&out), bits(&m0));
+
+    let e = |r: Result<(), String>, needle: &str| {
+        let m = r.expect_err(needle);
+        assert!(m.contains(needle), "{m:?} lacks {needle:?}");
+    };
+    let n = table.len();
+    e(
+        model.read_parameter_host(n, &mut []),
+        &format!("entry {n} of a {n}-entry table"),
+    );
+    e(
+        model.read_parameter_host(0, &mut [0.0; 3]),
+        "3 values for storage shape",
+    );
+    // A refused write leaves the entry as it was.
+    let last = n - 1;
+    let mut was = vec![0.0; table[last].shape.iter().product()];
+    model.read_parameter_host(last, &mut was).unwrap();
+    e(
+        model.write_parameter_host(last, &[1.0; 3]),
+        "3 values for storage shape",
+    );
+    let mut now = vec![0.0; was.len()];
+    model.read_parameter_host(last, &mut now).unwrap();
+    assert_eq!(bits(&now), bits(&was));
+    let (_, bf16, _) = load(Precision::Bf16);
+    e(bf16.read_parameter_host(0, &mut []), "Precision::F32");
+}
