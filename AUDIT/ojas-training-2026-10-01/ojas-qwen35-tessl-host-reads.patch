+/// Where an entry's storage-layout value sits in a tessl buffer: `rows` runs
+/// of `width` f32, the first at element `start`, each `ld` after the last.
+struct Window<'a> {
+    buf: &'a GpuBuffer,
+    start: usize,
+    rows: usize,
+    width: usize,
+    ld: usize,
+}
+
+/// The [`Window`] of `at` for an entry of `info`, holding exactly `len`
+/// values. Every bound is checked here, before the buffer is mapped.
+fn window<'a>(at: Src<'a>, info: &ParamInfo, len: usize) -> Result<Window<'a>, String> {
+    let shape = info.storage_shape();
+    let n = shape
+        .iter()
+        .try_fold(1usize, |a, &d| a.checked_mul(d))
+        .ok_or_else(|| format!("storage shape {shape:?} overflows"))?;
+    if len != n {
+        return Err(format!("{len} values for storage shape {shape:?}"));
+    }
+    let w = match at {
+        Src::Raw(b) => Window {
+            buf: b,
+            start: 0,
+            rows: 1,
+            width: n,
+            ld: n,
+        },
+        Src::Dense(t) => {
+            if t.dtype != DType::F32 || t.shape() != shape.as_slice() {
+                return Err(format!("tessl holds {:?} {:?}", t.dtype, t.shape()));
+            }
+            Window {
+                buf: &t.buffer,
+                start: t.byte_offset() / 4,
+                rows: 1,
+                width: n,
+                ld: n,
+            }
+        }
+        Src::Packed(t, off) => {
+            let (rows, width) = (info.shape[1], info.shape[0]);
+            let s = t.shape();
+            let fits = s.len() == 2 && s[0] == rows && off.checked_add(width).is_some_and(|e| e <= s[1]);
+            if t.dtype != DType::F32 || !fits {
+                return Err(format!(
+                    "columns [{off}, {off} + {width}) of {rows} rows in a {:?} {s:?} matrix",
+                    t.dtype
+                ));
+            }
+            Window {
+                buf: &t.buffer,
+                start: t.byte_offset() / 4 + off,
+                rows,
+                width,
+                ld: s[1],
+            }
+        }
+    };
+    // One past the last element touched (nothing is touched with no rows).
+    let end = match w.rows.checked_sub(1) {
+        None => Some(w.start),
+        Some(last) => last
+            .checked_mul(w.ld)
+            .and_then(|x| x.checked_add(w.start))
+            .and_then(|x| x.checked_add(w.width)),
+    }
+    .ok_or("window end overflows")?;
+    let have = w.buf.nbytes() / 4;
+    if end > have {
+        return Err(format!("the window ends at element {end}, the buffer holds {have}"));
+    }
+    Ok(w)
+}
+
+fn host_read(from: Src<'_>, info: &ParamInfo, out: &mut [f32]) -> Result<(), String> {
+    let w = window(from, info, out.len())?;
+    let map = w.buf.try_contents_f32()?;
+    for r in 0..w.rows {
+        let a = w.start + r * w.ld;
+        out[r * w.width..(r + 1) * w.width].copy_from_slice(&map[a..a + w.width]);
+    }
+    Ok(())
+}
+
+fn host_write(to: Src<'_>, info: &ParamInfo, src: &[f32]) -> Result<(), String> {
+    let w = window(to, info, src.len())?;
+    let mut map = w.buf.try_contents_f32()?;
+    for r in 0..w.rows {
+        let a = w.start + r * w.ld;
+        map[a..a + w.width].copy_from_slice(&src[r * w.width..(r + 1) * w.width]);
+    }
+    Ok(())
+}
