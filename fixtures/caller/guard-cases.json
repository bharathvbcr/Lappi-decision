   "expect": "unscannable"
  },
  {
   "name": "form feed separates rows",
   "text": "{\"a\":1}\f{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
   "expect": "unscannable"
  },
  {
