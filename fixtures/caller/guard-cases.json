  {
   "name": "file separator separates rows",
   "text": "{\"a\":1}\u001c{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "file separator inside a string value (a raw control character is not legal JSON, so refused)",
   "text": "{\"a\":\"x\u001cy\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "group separator separates rows",
   "text": "{\"a\":1}\u001d{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "group separator inside a string value (a raw control character is not legal JSON, so refused)",
   "text": "{\"a\":\"x\u001dy\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "record separator separates rows",
   "text": "{\"a\":1}\u001e{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "record separator inside a string value (a raw control character is not legal JSON, so refused)",
   "text": "{\"a\":\"x\u001ey\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "next line U+0085 separates rows",
   "text": "{\"a\":1}\u0085{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
   "expect": "unscannable"
  },
  {
   "name": "next line U+0085 separates rows at end of file",
   "text": "{\"a\":1}\u0085",
   "expect": "unscannable"
  },
  {
   "name": "next line U+0085 inside a string value is data",
   "text": "{\"a\":\"x\u0085y\"}\n{\"b\":2}\n",
   "expect": "clean"
  },
  {
   "name": "next line U+0085 inside a string after an escaped quote is data",
   "text": "{\"a\":\"q\\\"\u0085x\"}\n",
   "expect": "clean"
  },
  {
   "name": "next line U+0085 after a string closed by an escaped backslash separates rows",
   "text": "{\"a\":\"\\\\\"}\u0085{\"b\":2}\n",
   "expect": "unscannable"
  },
  {
   "name": "next line U+0085 inside a string, then a record on the next line",
   "text": "{\"a\":\"x\u0085y\"}\n{\"record\":\"lappi.caller_record\",\"record_version\":1,\"kind\":\"decision\"}\n",
