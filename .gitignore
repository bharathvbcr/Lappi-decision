# Rust
/target
**/*.rs.bk
# Cargo.lock IS tracked: qd-preflight is a binary, and this repo pins its Python
# stack in stack/requirements.lock for the same reason -- a number is only
# reproducible from the versions that produced it.

# Local code-intelligence index (DevMap). Rebuildable from the tree by
# `devmap build`, and a multi-megabyte SQLite store that no reader needs.
/.devmap/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data pool, shards, checkpoints — large, reproducible from manifests.
# The manifests themselves ARE tracked: they are the provenance record.
/data/pool/
/data/shards/
/data/checkpoints/
*.npy.gz
*.safetensors
*.bin

# Never commit credentials or environment files.
.env
.env.*
*.pem
*-service-account*.json

# Container build logs. The lockfile and Containerfile are tracked; their output is not.
stack/.build.log

# macOS
.DS_Store

# The ledger is append-only and IS tracked — it is the decision record.
# Nothing under ledger/ is ignored.
